ព } $vowels > p; # U+1796
ភ } $vowels > ph; # U+1797
ម } $vowels > m; # U+1798
# At the end of the word this goes to empty.
# Example: ពាក្យ (peak)
#យ } [$] > ; # U+1799
យ } $vowels > y; # U+1799
រ } $vowels > r; # U+179A
ល } $vowels > l; # U+179B
វ } $vowels > v; # U+179C
