ch <> \u0445 ; # CYRILLIC SMALL LETTER HA
H > \u0425 ; # CYRILLIC CAPITAL LETTER HA
h > \u0445 ; # CYRILLIC SMALL LETTER HA

#TS > \u0426 ; # CYRILLIC CAPITAL LETTER TSE
#ts} [kt] > \u0442\u0441 ; # Common combination where ts should not be converted to TSE
#ts > \u0446 ; # CYRILLIC SMALL LETTER TSE (this hides an infrequent combination 't' 's')

\u0160\u010d <> \u0429 ; # CYRILLIC CAPITAL LETTER SHCHA
\u0161\u010d <> \u0449 ; # CYRILLIC SMALL LETTER SHCHA
