	ц > c;
	Ч > Ç;
	ч > ç;
	Ш > Ş;
	ш > ş;
	Щ > Şç;
	щ > şç;
	Ъ > ;
	ъ > ;
	І > I;
 	і > i;
	Ы > I;
	ы > ı;
