អ > a; # U+17A2

# Khmer word repetition symbol ៗ U+17D7 repeats preceeding word.
# This needs to be treated in preprocessing and is deleted here.
\u17D7 > ;


# questions
# U+17C8-U+17D3 and sU+17DD
\u17C8 > ; # U+17C8 Yukaleakpintu
\u17C9 > ; # U+17C9 Muusikatoan
