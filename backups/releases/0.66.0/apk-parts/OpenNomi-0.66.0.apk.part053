	ແ > ae;
	າ > a;
	ັ > a;
	ະ > a;
# Digits
	໐ > 0;
	໑ > 1;
	໒ > 2;
	໓ > 3;
	໔ > 4;
	໕ > 5;
	໖ > 6;
	໗ > 7;
	໘ > 8;
	໙ > 9;
# Remove other markers
	\u0ec8 > ;
	\u0ec9 > ;
# Remove any left-overs
	[^[:Latin:][:Digit:][:Space:]] > ;
␀␀# Author: suno@google.com (Yuji Sunouchi)

#
# Transformation from Latin languages to English-like ascii languages.

#::NFC;

# German
# Based on: http://en.wikipedia.org/wiki/German_alphabet
ß → ss;
Ü → Ue;
ü → ue;
Ö → Oe;
ö → oe;
é → ee;
Ä → Ae;
ä → ae;

# Spanish
# Based on:
#   http://en.wikipedia.org/wiki/Spanish_orthography
#   Spanish-Russian.txt

#Ll → Ll;
#ll → j;
#h → ;
#H (.) → | &Upper($1);
#J → H;
#j → h;
#Ñ → Ny;
#Ñ → ny;
#Tz → Ts;
#tz → ts;

#Y[AÁaá] → Ja;
#Y[EÉeé] → Je;
#Y[UÚuú] → Ju;
#Y[OÓoó] → Jo;
#Y → I;
#y[aá] → ja;
#y[eé] → je;
#y[oó] → jo;
#y[uú] → ju;
#y → i;

# Portuguese
# Based on:
#   http://en.wikipedia.org/wiki/Portuguese_alphabet
#   http://homepage3.nifty.com/ROSSO/%83%7C%83%8B%83g%83K%83%8B%8C%EA%82%CC%93%C7%82%DD%95%FB.html (In Japanese)
# h → ;
# H (.) → | &Upper($1);

# Italian
# Based on:
#   http://en.wikipedia.org/wiki/Italian_alphabet

␀␀␀␀␀␀␀# Copyright (C) 2010 Google Inc.  All Rights Reserved.
# Author: sascha@google.com (Sascha Brawer)
#
# Transformation from Latin (la) to its IPA transcription (la_FONIPA).
# http://en.wikipedia.org/wiki/Latin_spelling_and_pronunciation
# http://en.wikipedia.org/wiki/Wikipedia:IPA_for_Latin
#
# These rules follow the Wikipedia description of the presumed pronunciation
# of Classical Latin.  This is different from Medieval Latin, and it is also
# different from the ecclesiastical pronunciation used by the Roman Catholic
# church.

::Lower;
::NFC;

$vowel = [aáàăāeéèĕēiíìĭīoóòŏōuúùŭūæœ];
$end_of_word = [$ ];

ae → aj;
av → aw;
æ → aj;  # 19th century English orthography
ā → aː;
[aáàă] → a;
b → b;
ch → kʰ;  # Greek loanwoards
c → k;
d → d;
ev → ew;
ē → eː;
[eéèĕ] → ɛ;
f → f;
{g} n → ŋ;  # eg. agnus
g → ɡ;
h → h;
ī → iː;
{[iíìĭ]} $vowel → j;  # eg. cuius
[iíìĭ] → ɪ;
k → k;
l → l;
m → m;
{n} [bpfm] → m;  # eg. infirmus
{n} [gckq] → ŋ;  # eg. quinque
n → n;
œ → oj;  # 19th century English orthography
oe → oj;
ō → oː;
[oóòŏ] → ɔ;
ph → pʰ;  # Greek loanwords
p → p;
qu → kʷ;
qv → kʷ;
rh → rʰ;  # Greek loanwords
r → r;
s → s;
th → tʰ;  # Greek loanwords
t → t;
ū → uː;
[uúùŭ] → ʊ;
{v} $vowel → w;
v → u;
xs → ks;  # Old Latin spelling
x → ks;
y → y;  # Greek loanwords
z → d͡z;  # eg. zerum

::Null;

# Gemination of double consonants.
# http://en.wikipedia.org/wiki/Latin_spelling_and_pronunciation#Double_consonants

bb → bː;
dd → dː;
ɡɡ → ɡː;
hh → hː;
kk → kː;
ll → lː;
mm → mː;
nn → nː;
pp → pː;
rr → rː;
ss → sː;
tt → tː;

# Velarization of [l].
# http://en.wikipedia.org/wiki/Latin_spelling_and_pronunciation#cite_note-20
{l} [^aeɛiouː] → ɫ;

::NFC;
␀␀␀␀␀␀␀# Copyright 2010 Google Inc. All Rights Reserved.
# Author: sascha@google.com (Sascha Brawer)
#
# Transforms Lower Sorbian (dsb) to its IPA transcription (dsb_FONIPA).
# http://en.wikipedia.org/wiki/Sorbian_alphabet

# Transform input to normalized form NFC, and to lowercase.
::NFC;
::Lower;

a  → a ;
b́  → bʲ ;   # old spelling
bj → bʲ ;   # modern spelling
b  → b ;
ch → x ;
č  → t \u0361 ʃ ;  # affricate indicated by ligature tie
ć  → t \u0361 ɕ ;  # affricate indicated by ligature tie
c  → t \u0361 s ;  # affricate indicated by ligature tie
dź → d \u0361 ʑ ;  # affricate indicated by ligature tie
d  → d ;
ě  → iɪ̯;
e  → ɛ ;
f  → f ;
g  → ɡ ;
h  → h ;
i  → i ;
j  → j ;
k  → k ;
ł  → v ;
l  → l ;
ḿ  → mʲ ;   # old spelling
mj → mʲ ;   # modern spelling
m  → m ;
ń  → ɲ ;
n  → n ;
ó  → ɛ ;
o  → ɔ ;
ṕ  → pʲ ;   # old spelling
pj → pʲ ;   # modern spelling
p  → p ;
ř  → ʃ ;
ŕ  → rʲ ;
r  → r ;
š  → ʃ ;
ś  → ɕ ;
s  → s ;
t  → t ;
u  → u ;
ẃ  → wʲ ;   # old spelling
wj → wʲ ;   # modern spelling
w  → w ;
y  → ɨ ;
ž  → ʒ ;
ź  → ʑ ;
z  → z ;

::NFC;

# Assimilation.
b } [k]  → p ;
d } [k]  → t ;
ʃt͡ɕ → ɕt͡ɕ ;

# Final de-voicing.
b } [$] → p ;
d \u0361 z } [$] → t \u0361 s ;
d } [$] → t ;
ɡ } [$] → k ;
v } [$] → f ;
w } [$] → f ;
ʑ } [$] → ɕ ;
z } [$] → s ;
ʒ } [$] → ʃ ;
␀␀# This file fills a gap in the standard ICU transliteration of Malayalam, which
# currently fails to transliterate chillu characters properly. (b/18078450)
#
# After ICU has been updated to include these transliterations, this rule file
# and its associated use in google3/i18n/translit (cl/78362947) can be removed.
#
# The current (ver. 54.1) ICU Malayalam transilterator skips singlecode-point
# chillus.  When Chillus are represented in the old, deprecated way, using a
# sequence of code points ending with a zero-width joiner, they are
# transliterated, though the zero-width joiner is preserved in the Romanized
# output, e.g.:
# - ർ (U+0D7C) is not transliterated.
# - ര്‍ (U+0D30 U+0D4D U+200D) is transliterated as "r‍" (U+0072 U+200D)
#
# You can try the current ICU transliterator on their demo page here, to see
# if support for chillus has improved:
# http://demo.icu-project.org/icu-bin/translit

# First pass: convert any old-style multi-code-point chillus to the
# single-code point, for uniform handling.  This is needed because the current
# ICU transliteration of multi-code-point chillus leaves the zero-width joiner
# (U+200D) in the Latin result
ണ്‍ → ൺ; # CHILLU NN U+0D23 U+0D4D U+200D → U+0D7A
ന്‍ → ൻ;  # CHILLU N  U+0D28 U+0D4D U+200D → U+0D7B
ര്‍ → ർ;   # CHILLU RR U+0D30 U+0D4D U+200D → U+0D7C
ല്‍ → ൽ;  # CHILLU L  U+0D32 U+0D4D U+200D → U+0D7D
ള്‍ → ൾ;   # CHILLU LL U+0D33 U+0D4D U+200D → U+0D7E
ക്‍ → ൿ;  # CHILLU K  U+0D15 U+0D4D U+200D → U+0D7F

# Reset to the beginning of the string, so the chillu rules below will apply to
# any single-code-point chillus added by the first pass.
::Null;

# Second pass: transliterate the chillus.
ൺ → ṇ;
ൻ → n;
ർ → r;
ൽ → l;
ൾ → ḷ;
ൿ → k;

# Everything else is handled by the current ICU Malayalam transliterator.
::Malayalam-Latin;
␀␀␀# Copyright 2009 Google Inc. All Rights Reserved.
# Author: mjansche@google.com (Martin Jansche)
#
# Cyrillization of Mandarin Chinese from Pinyin into Russian (Palladius system).
#
# References:
#   http://ru.wikipedia.org/wiki/Транскрипционная_система_Палладия
#   http://www.omniglot.com/writing/mandarin_pts.htm
#   http://www.pinyin.info/romanization/russian/index.html
# These differ in the treatment of some syllables (e.g. <jue>) from the rules
# below.
#
# Further commentary:
#   http://languagelog.ldc.upenn.edu/nll/?p=604

# Remove tone marks.
:: NFD (NFC);
[\u0304\u0301\u030C\u0300\u0306] → ;
:: NFC (NFD);

# Syllabify. Add apostrophes to disambiguate whether <n> and <g> belong to the
# coda or onset of a syllable.
:: Null ();
ng } [aeou] → n\'g;
ng → ng\';
n } [aeiouü] → \'n;
n → n\';

# Main pass.
:: Null ();

Ai → Ай;
A  → А;
B  → Б;
Ch → Ч;
Ci → Цы;
C  → Ц;
D  → Д;
E  → Э;
F  → Ф;
G  → Г;
H  → Х;
Ju → Цз | ü;
J  → Цз;
K  → К;
L  → Л;
M  → М;
N  → Н;
O  → О;
P  → П;
Qu → Ц | ü;
Q  → Ц;
R  → Ж;
Sh → Ш;
Si → Сы;
S  → С;
T  → Т;
Wu → У;
W  → В;
Xu → С | ü;
X  → С;
Yai → Яй;
Ya → Я;
Ye → Е;
Yi → И;
You → Ю;
Yo } ng → Ю;
Yo → Ё;
Yu → Ю | v;
Zh → Чж;
Zi → Цзы;
Z  → Цз;

[$] { n → н;
\'n → н;
\'  → ;

ai → ай;
a  → а;
b  → б;
ch → ч;
ci → цы;
c  → ц;
d  → д;
ei → эй;
e  → э;
f  → ф;
g  → г;
h  → х;
ia → я;
ie → е;
io } ng → ю;
iu → ю;
i  → и;
ju → цз | ü;
j  → цз;
k  → к;
l  → л;
m  → м;
ng → н;
n  → нь;
o } ng → у;
o  → о;
p  → п;
qu → ц | ü;
q  → ц;
r } [^aeiou] → р;
r  → ж;
sh → ш;
si → сы;
s  → с;
t  → т;
[Хх] { ui → уэй;  # special exception
ui → уй;
uo → о;
u  → у;
ü  → ю | v;
# We use the dummy symbol <v> to signal that an <ü> or equivalent character has
# just been processed.
ve → э;
#alternative: ve → е;
v } [an] → ;
v  → й;
wu → у;
w  → в;
xu → с | ü;
x  → с;
yai → яй;
ya → я;
ye → е;
yi → и;
you → ю;
yo } ng → ю;
yo → ё;
yu → ю | v;
zh → чж;
zi → цзы;
z  → цз;

# Final pass: Make sure that the output consists entirely of Cyrillic letters.
:: NFC ();
[^\ А-ЖИК-ПС-ШЭ-ЯЁ а-шы-яё] → \uFFFE;
␀␀␀␀␀␀␀␀␀␀␀#![MONGOLIAN,ENGLISH]
# ICU LanguagePair for transliteration model.
