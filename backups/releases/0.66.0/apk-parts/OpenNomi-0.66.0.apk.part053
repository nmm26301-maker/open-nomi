z <>  \u0437 ; # CYRILLIC SMALL LETTER ZE

I\u0306 > \u0419 ; # CYRILLIC CAPITAL LETTER SHORT I
J <> \u0419 ; # CYRILLIC CAPITAL LETTER SHORT I
\u012d  > \u0439 ; # CYRILLIC SMALL LETTER I
i\u0306 > \u0439 ; # CYRILLIC SMALL LETTER I
j <> \u0439 ; # CYRILLIC SMALL LETTER SHORT I
\u0131\u0306 > \u0439 ; # CYRILLIC SMALL LETTER SHORT I

\u012a <> \u0406 ; # CYRILLIC CAPITAL LETTER Byelorussian-Ukrainian I
\u012b <> \u0456 ; # CYRILLIC SMALL LETTER Byelorussian-Ukrainian I

L <>  \u041b ; # CYRILLIC CAPITAL LETTER EL
l <>  \u043b ; # CYRILLIC SMALL LETTER EL
