␀␀␀␀# Copyright 2012 Google Inc. All Rights Reserved.
# Author: kiddi@google.com (Kristinn Gudjonsson)

# Transforms Icelandic (is) to Icelandic in IPA transcription (is_FONIPA).
#
# Sources for information:
# http://en.wikipedia.org/wiki/Icelandic_language#Sounds
# http://en.wikipedia.org/wiki/Icelandic_orthography
#
# Wordlist with around 56k frequent Icelandic words that was made
# for the Hjal project in 2003. Distributed using the CC BY license.
# Can be found under: //depot/google3/third_party/speech/islex

::Lower;
::NFC;

$vowel = [aáeéiíoóuúöyýæ];
$acc_vowel = [áéíóúý];
$enn = n[gk];
$lokhljod = [ptk];

# combination of vowels
ei > ɛi̯;
ey > ɛi̯;
au > œy̯;

# Vowels.
a } $enn > äu̯;
#a > ä:; # long: taska
#a > ɐ;  # short: kaka
a > a;
á > äu̯;
e } $enn > ɛi̯;
#e > eɛ̯; # long: skera
e > ɛ; # short: drekka
é > jɛ;
i > ɪ;
í > i;
y > ɪ;
ý > i;
#o > oɔ̯; # long: lofa
o > ɔ; # short: dolla
ó > ou̯;
u } $enn > u;
u > ʏ;
ú > u;
æ > äi̯;
ö > œ;

# combination of consonants
fnd > mt;
fnt > m̥t;
gj > c⁼;
hj > ɕ;
hl > l̥;
hr > r̥;
hv > kʰv; # xv in some dialects
[$] { kj > cʰ;
kj > c⁼;
kk > ʰk;
#ll > lː; # loan words, pet names
ll > tl;
$acc_vowel { nn > tn̥; # missing: diphthongs 
nn > nː;
pp > ʰp;
rl > rtl̥;
rn > rtn̥;
sl > stl̥;
sn > stn̥;
tt > ʰt;
bb > p;
dd > t;
ss > s;

# Consonants.
b > p;
c > k;
d > t;
$vowel { ð } $vowel > ð̠;
ð } [$] > ð̠;
ð > θ̠;
ó { f } $vowel > Ø;
$vowel { f } $vowel > v;
f } [ln] > p;
f > f;
[$] { g } [aáéoóuúö] > k;
$vowel { g } [ln] > k;
[$] { g } e[iy] > c;
[$] { g } [eiíjyýæ] > c;
$vowel { g > ɣ;
g } [auðr$] > ɣ;
g } [ts] > x;
$vowel { g } [ji] > j;
[áóúau] { g } [áóúau] > Ø;
j > j;
[$] { k } e[iy] > cʰ;
[$] { k } [eiíyýæ] > cʰ;
k } t > x;
k > kʰ;
l } [$] > l̥;
l > l;
# m > m̥ ; # before and after voiceless consonants
m > m;
# n > n̥ ; # before and after voiceless consonants
n > n;
p } [skt] > f;
[\ ] { p > pʰ;
# $voiceless { p > p⁼; # missing voiceless sound
[$] { r > r;
$vowel { r } $vowel  > r;
r > r̥; # before/after voiceless consonants, end of a pause
s > s;
[$] { t > tʰ;
#$voiceless { t > t⁼;
v > v;
x > xs;
þ > θ̠ ;

::NFC;
␀␀␀␀␀␀␀␀␀␀␀# Copyright (C) 2010 Google Inc.  All Rights Reserved.
# Author: sascha@google.com (Sascha Brawer)
#
# Transformation from Interlingua (ia) to its IPA transcription (ia_FONIPA).
# http://en.wikipedia.org/wiki/Interlingua#Interlingua_alphabet
# http://www.omniglot.com/writing/interlingua.htm

::NFC;
::Lower;

# Interlinua has five falling diphthongs.
# http://en.wikipedia.org/wiki/Interlingua#Orthography_and_pronunciation
ai → ai̯;
au → au̯;
ei → ei̯;  # rare
eu → eu̯;
oi → oi̯;  # rare

# ‹g› is usually [ɡ], but it is [d͡ʒ] in -age, -agi-, and -egi-.
# http://www.omniglot.com/writing/interlingua.htm
$end_of_word = [$ ];
{age} $end_of_word → ad͡ʒe;
agi → ad͡ʒi;
egi → ed͡ʒi;
g → ɡ;

# Omniglot: “The sounds of g and k assimilate a preceding n as in English.”
{n} [gkqx] → ŋ;
n → n;

a → a;
b → b;
{c} [ei] → t͡s;
ch → k;
c → k;
d → d;
e → e;
f → f;
h → ;  # ‹h› is normally silent.
i → i;
j → ʒ;
k → k;
l → l;
m → m;
o → o;
ph → f;  # philosophos, physica
p → p;
que → ke;
qu → kʷ;
q → k;
r → r;
sh → ʃ;  # rare
s → s;
[^s] {ti} [aeiouy] → t͡sj;
t → t;
u → u;
v → v;
w → v;
x → ks;
y → i;
z → z;

::Null;

# Double consonants are not distinguished in pronunciation.
bb → b;
dd → d;
ff → f;
ɡɡ → ɡ;
hh → h;
kk → k;
ll → l;
mm → m;
nn → n;
pp → p;
rr → r;
ss → s;
tt → t;

