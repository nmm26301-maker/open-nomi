# Drop hyphens and apostrophes.
[\-\'] → ;

# Turn long /e:/ into diphthong /ei/.
e $lengthMarker → | e i ;

# Ignore vowel length everywhere else.
$lengthMarker → ;

# Vowels.

[^$consonant] { ( [aiueoyw] ) → ᄋ | $1 ;  # Supply a required null initial.
