␀␀␀␀␀␀␀# Copyright 2015 Google Inc
# Author: Alex Rudnick ajr@google.com
# Post-processing code for Arabic romanization

$ayin = ʿ ;     # ICU rules represent ayin with MODIFIER LEFT HALF RING
$hamza = ʾ ;    # ICU rules represent hamza with MODIFIER RIGHT HALF RING
$sukun =  ̊ ;    # ICU rules represent sukun with COMBINING RING ABOVE

$ayin > e ;      # turn ayin into an 'e'
$hamza > \' ;    # turn hamza into an ASCII apostrophe
ⁿ > n ;          # turn the superscript 'n' into a regular 'n'
$sukun > ;       # drop any stray sukun
␀␀␀␀␀␀␀␀# Copyright 2009 Google Inc
# Author: Frank Tang ftang@google.com
# Post processing code for Chinese pinyin
#
# Remove the Dot between Katakana
\･ > ;
# Remove SPACE between Open Punctuation (Ps),
# Initial Punctuation (Pi) AND Letter (L), Number (N), Symbol (S)
[[:Ps:][:Pi:]“`] {(' ') ([[:L:][:N:][:S:]])  >  $2;
# Remove SPACE between Letter (L), Number (N), Symbol (S)
#  AND Close Punctuation (Pe), Final Punctuation (Pf), 
#  Other Punctuation (Po)
([[:L:][:N:][:S:]]) (' ') } [[:Pe:][:Pf:][:Po:]]  >  $1;
# Remove SPACE between Close Punctuation (Pe), 
#  Final Punctuation (Pf) AND Other Punctuation (Po)
([[:Pe:][:Pf:]]) ' ' } [[:Po:]] >  $1;
# in a separate pass
::Null;
# Titlecase the first letter
([[:L:]]) ([^.?!\:]*) > &Any-Title($1) $2;
# Titlecase the first letter after .?!: and SPACE
[.?!\:] ' ' { ([[:L:]]) ([^.?!\:]*)  > &Any-Title($1) $2; 
␀␀␀␀␀␀␀␀␀␀␀␀␀␀# Copyright 2015 Google Inc
# Author: Alex Rudnick ajr@google.com
# Post-processing code for Hindi romanization

# Get ready to work on some accents.
::NFD;

# n with macron goes to just 'n'
n \u0304 > n ;

# fix up long and short 'e'
e \u0304 > e ;
e > ai ;

# fix up long and short 'o'
o \u0304 > o ;

# u with macron was DEVANAGARI LETTER UU, which should transliterate as 'oo'
u \u0304 > oo ;

# i with macron goes to "ee"
i \u0304 > ee ;

# For any other letter that has a macron on it, double that letter.
([:Letter:]) \u0304 > $1 $1 ;

# Change an m with COMBINING DOT ABOVE to an 'n'.
m \u0307  > n ;
# Same with COMBINING CANDRABINDU.
m \u0310  > n ;

# map both ṣ and ś to sh
s \u0323 > sh ; # s with COMBINING DOT BELOW
s \u0301 > sh ; # s with COMBINING ACUTE ACCENT

# map ṛ (produced from DHA, DDHA, and DDDHA) to d
r \u0323 > d ; # r with COMBINING DOT BELOW

# Every time we got 'c', it must have come from DEVANAGARI LETTER CA or
# DEVANAGARI LETTER CHA. We want CA to map to 'ch' and CHA to map to 'chh', so
# just change every 'c' to 'ch'.
c > ch ;

# JA with DEVANAGARI SIGN VIRAMA followed by NYA should be "gy" not "jñ"
jn \u0303 > gy ;

# Remove any remaining accents.
::[:Nonspacing Mark:] Remove;
::NFC;

# remove "'" which is not usually typed by users.
\' > ;

# Use this $wordBoundary until bug 2034 is fixed in ICU:
$wordBoundary =  [^[:L:][:M:][:N:]] ;

# Remove word-final 'a' when the word is longer than 2 characters long.
[:Letter:] [:Letter:] { a } $wordBoundary > ;

::Lower;
␀␀# Some modifications for Arabic romanization, used by Translate for display.
# Includes a few bits adapted from Arabic-Latin-BGN.xml.

# TODO(ajr): Better Shadda handling; make this work even if there is another
#   diacritic on the letter.
# Get duplications right when we have a SHADDA character.
بّ  > 'bb' ;   # ARABIC LETTER BEH + SHADDA
تّ  > 'tt' ;   # ARABIC LETTER TEH + SHADDA
ثّ  > 'thth' ; # ARABIC LETTER THEH + SHADDA
جّ  > 'jj' ;   # ARABIC LETTER JEEM + SHADDA
حّ  > 'hh' ;   # ARABIC LETTER HAH + SHADDA
خّ  > 'khkh' ; # ARABIC LETTER KHAH + SHADDA
دّ  > 'dd' ;   # ARABIC LETTER DAL + SHADDA
ذّ  > 'dhdh' ; # ARABIC LETTER THAL + SHADDA
رّ  > 'rr' ;   # ARABIC LETTER REH + SHADDA
زّ  > 'zz' ;   # ARABIC LETTER ZAIN + SHADDA
سّ  > 'ss' ;   # ARABIC LETTER SEEN + SHADDA
شّ  > 'shsh' ; # ARABIC LETTER SHEEN + SHADDA
صّ  > 'ss' ;   # ARABIC LETTER SAD + SHADDA
ضّ  > 'dd' ;   # ARABIC LETTER DAD + SHADDA
طّ  > 'tt' ;   # ARABIC LETTER TAH + SHADDA
ظّ  > 'zz' ;   # ARABIC LETTER ZAH + SHADDA
عّ  > 'ee' ;   # ARABIC LETTER AIN + SHADDA; Translate output shows ayin as 'e'.
غّ  > 'ghgh' ; # ARABIC LETTER GHAIN + SHADDA
فّ  > 'ff' ;   # ARABIC LETTER FEH + SHADDA
قّ  > 'qq' ;   # ARABIC LETTER QAF + SHADDA
كّ  > 'kk' ;   # ARABIC LETTER KAF + SHADDA
لّ  > 'll' ;   # ARABIC LETTER LAM + SHADDA
مّ  > 'mm' ;   # ARABIC LETTER MEEM + SHADDA
نّ  > 'nn' ;   # ARABIC LETTER NOON + SHADDA
هّ  > 'hh' ;   # ARABIC LETTER HEH + SHADDA
وّ  > 'ww' ;   # ARABIC LETTER WAW + SHADDA
ىّ  > 'yy' ;   # ARABIC LETTER YEH + SHADDA

## Some suggestions from riesa@ and pendar@
'إ'   > \''i' ;     # (previously "ai")
'أَ'   > \''a' ;     # (previously "aa")
'أُ'   > \''u' ;     # (previously "au")
'ى'   > 'a'   ;     # (previously "y"; this letter is not the same as ي)

# Use this $wordBoundary until bug 2034 is fixed in ICU:
$wordBoundary =  [^[:L:][:M:][:N:]] ;

## Orthographic rules prevent words from ending in a fatha tanween (fathatan)
## unless it is on an alif, hamza, or ta marbuta. In such cases
## an alif is tacked on and the fatha tanween may or may not be moved
## In case the fatha tanween stays put, the fatha tanween-alif sequence
## should still be pronounced as a regular fathatan
{ ًا } $wordBoundary > 'an' ;
{ ًى } $wordBoundary > 'an' ;

{ وا } $wordBoundary > 'u' ;   # only when it's the last two letters of the word

## TEH MARBUTA goes to empty string, if it's the last letter in a sentence.
## Strictly speaking, it's a syntactic issue whether this is pronounced, but
## for know "end of a sentence" is close enough.
$eos = [[:Sentence_Break=STerm:][:Sentence_Break=ATerm:]
        [:Sentence_Break=CR:][:Sentence_Break=LF:]
        [:Sentence_Break=Sep:][:Sentence_Break=Close:]] ;

## Match TEH MARBUTA next to an end of sentence marker
{ ة } (' ')* $eos > ;

## ... or next to the end of string.
{ ة } (' ')* $ > ;
␀␀␀␀# Copyright 2009 Google Inc
# Author: Frank Tang ftang@google.com
# Exclude Katakana for b/5588432
:: [[:^Katakana:]];
# Post processing for Chinese 
::Fullwidth-Halfwidth;
# change some common use full-width puncation which do not have straight 
# halfwidth mapping 
｡ > \.;
[《『] > “;
[》』] > ”;
[「｢] > \`;
[」｣] > \';
[、､] > \,;
【 > \[;
】 > \];
# in a separate pass  (by the ::Null;)
::Null;
# add a SPACE between Han character and Open Punctuation (Ps),  
# Initial Punctuation (Pi), Number (N), Upppercase Letter (Lu),
# Lowercase Letter (Ll), Titlecase Letter (Lt), Symbol (S)
([[:Han:]]) } [[:Ps:][:Pi:][:N:][:Lu:][:Ll:][:Lt:][:S:]] > $1 ' ' ;
# Do NOT add space before 々 for b/5588432, place before next rule.
(々) } [[:Han:]] > $1 ;
# add a SPACE between Close Punctuation (Pe),  
# Final Punctuation (Pf), Number (N), Upppercase Letter (Lu),
# Lowercase Letter (Ll), Modifier Letter (Lm)
# and Han character
([[:Pe:][:Pf:][:N:][:Lu:][:Ll:][:Lm:]]) } [[:Han:]] > $1 ' ' ;
␀␀␀␀␀␀␀␀␀␀␀␀␀# Copyright 2015 Google Inc
# Author: Alex Rudnick ajr@google.com
# Some modifications for Hindi romanization, used by Translate for display.

::NFD;
::Lower;

# Use this $wordBoundary until bug 2034 is fixed in ICU:
$wordBoundary =  [^[:L:][:M:][:N:]] ;

# Special cases for words with widely-used or idiosyncratic romanizations. Here
# in preprocessing, we write things that we don't want to be changed by the
# postprocessor in ALL CAPS so that postprocessing rules won't fire on them. The
# last step of postprocessing is to lowercase.

$wordBoundary { \u092e \u0947 \u0902 } $wordBoundary > MEIN ;
$wordBoundary { \u0928 \u0939 \u0940 \u0902 } $wordBoundary > NAHIN ;

# two Devanagari ways to spell omkara
$wordBoundary { \u0913\u0902\u0915\u093E\u0930\u093E } $wordBoundary > OMKARA ;
$wordBoundary { \u0913\u092E\u0915\u093E\u0930\u093E } $wordBoundary > OMKARA ;

$wordBoundary { \u0938 \u093e \u0921 \u093c \u0940 } $wordBoundary > SARI ;
$wordBoundary { \u0932 \u094b \u092e \u0921 \u093c \u0940 } $wordBoundary > LOMRI ;

