ww → wː;
jj → jː;
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀# Uzbek (uz) Latn to Cyrl

::NFD(NFC);

# left/right single quote mark(‘’), modifier apostrophe(ʼ), apostrophe (')
$apostrophe = [ʼ\'‘’];

# first, compound letters:
S H > Ш;
S h > Ш;
s h > ш;
C H > Ч;
C h > Ч;
c h > ч;
Y E > Е;
Y e > Е;
y e > е;
Y O > Ё;
Y o > Ё;
y o > ё;
Y U > Ю;
Y u > Ю;
y u > ю;
Y A > Я;
Y a > Я;
y a > я;
T S > Ц;
T s > Ц;
t s > ц;

# permit either an upturned comma (what it should be) or any apostrophe
O [ʻ$apostrophe] > Ў;
o [ʻ$apostrophe] > ў;
G [ʻ$apostrophe] > Ғ;
g [ʻ$apostrophe] > ғ;

# basic letters in alphabetical order
A > А;
a > а;
B > Б;
b > б;
D > Д;
d > д;

# Special handling for E/e at word beginning
[-\ $] { E > Э;
E > Е;
[-\ $] { e > э;
e > е;

F > Ф;
f > ф;
G > Г;
g > г;
H > Ҳ;
h > ҳ;
I > И;
i > и;
J > Ж;
j > ж;
K > К;
k > к;
L > Л;
l > л;
M > М;
m > м;
N > Н;
n > н;
O > О;
o > о;
P > П;
p > п;
Q > Қ;
q > қ;
R > Р;
r > р;
S > С;
s > с;
T > Т;
t > т;
U > У;
u > у;
V > В;
v > в;
X > Х;
x > х;
Y > Й;
y > й;
Z > З;
z > з;

# An spostrophe must occur between letters, or else it's not a letter.
[[:Lu:]] { $apostrophe } [[:Lu:]] > Ъ;
[[:L:]] { $apostrophe } [[:L:]] > ъ;

# for completeness: not valid Uzbek letters:
C > Ч;
c > ч;
W > В;
w > в;

␀␀␀␀␀␀␀␀#![UZBEK,ENGLISH]
