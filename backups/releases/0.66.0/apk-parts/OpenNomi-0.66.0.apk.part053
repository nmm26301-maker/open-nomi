::NFC;
␀␀␀␀␀␀␀␀␀#![TIBETAN,ENGLISH]
# ICU LanguagePair for transliteration model.
# Based on http://en.wikipedia.org/wiki/Wylie_transliteration
# and http://www.thlib.org/reference/transliteration/#!essay=/thl/ewts/all/

$consonants = [\u0F40-\u0F6A];
$prescript = [\u0F42\u0F51\u0F56\u0F58\u0F60];
$postscript = [\u0F42\u0F44\u0F51\u0F53\u0F56\u0F58\u0F60\u0F62\u0F63\u0F66];
$postpostscript = [\u0F51\u0F66];
$vowels = [\u0F71-\u0F7D\u0F80\u0F81];
$subjoinedconsonants = [\u0F90-\u0FBC];
$stackwithvowels = $consonants $subjoinedconsonants* $vowels+;
$stackwithoutvowels = $consonants $subjoinedconsonants+;
$bound = [^[$consonants][$subjoinedconsonants][$vowels][a]];

# Convert combined characters into their combinations.
\u0F43 > \u0F42\u0FB7;
\u0F4D > \u0F4C\u0FB7;
\u0F52 > \u0F51\u0FB7;
\u0F57 > \u0F56\u0FB7;
\u0F5C > \u0F5B\u0FB7;
\u0F69 > \u0F40\u0FB5;

\u0F73 > \u0F71\u0F72;
\u0F75 > \u0F71\u0F74;
\u0F76 > \u0FB2\u0F80;
\u0F77 > \u0FB2 | \u0F81;
\u0F78 > \u0FB3\u0F80;
\u0F79 > \u0FB3 | \u0F81;
\u0F81 > \u0F71\u0F80;

\u0F93 > \u0F92\u0FB7;
\u0F9D > \u0F9C\u0FB7;
\u0FA2 > \u0FA1\u0FB7;
\u0FA7 > \u0FA6\u0FB7;
\u0FAC > \u0FAB\u0FB7;
\u0FB9 > \u0F90\u0FB5;

::Null;

# Second pass: insert the default 'a'.
# insert 'a' after a stack without a vowel.
{ ($stackwithoutvowels) } [^$vowels] > $1 a;
# insert 'a' after root in 'prescript + root + postscript + postpostscript'.
$bound { ($prescript $consonants) ($postscript $postpostscript) } $bound > $1 a $2;
# insert 'a' after root in 'root + postscript + postpostscript'.
$bound { ($consonants) ($postscript) ($postpostscript) } $bound > $1 a $2 $3;
# insert 'a' after root in 'prescript + root + postscript'.
$bound { ($prescript) ($consonants) ($postscript) } $bound > $1 $2 a $3;
# insert 'a' after root in 'root + postscript'.
$bound { ($consonants) ($postscript) } $bound > $1 a $2;
# insert 'a' after root in 'prescript + root'.
$bound { ($prescript) ($consonants) } $bound  > $1 $2 a;
# insert 'a' after root in 'root'.
$bound { ($consonants) } $bound > $1 a;
# special cases: 'root + stack', insert 'a' after root.
$bound { ([$consonants - $prescript]) } $stackwithvowels > $1 a;
$bound { ([$consonants - $prescript]) } $stackwithoutvowels > $1 a;

::Null;

# Third pass: transliterate characters.
# vowels
\u0F71\u0F72 > I;
\u0F72 > i;
\u0F71\u0F74 > U;
\u0F74 > u;
\u0F7A > e;
\u0F7B > ai;
\u0F7C > o;
\u0F7D > au;
\u0F71\u0F80 > '-I';
\u0F80 > '-i';
\u0F71 a > A;

# consonants, subjoined consonants, fixed-form subjoined consonants
[\u0F40\u0F90] > k;
[\u0F41\u0F91] > kh;
[\u0F42\u0F92] > g;
[\u0F44\u0F94] > ng;
[\u0F45\u0F95] > c;
[\u0F46\u0F96] > ch;
[\u0F47\u0F97] > j;
[\u0F49\u0F99] > ny;
[\u0F4A\u0F9A] > T;
[\u0F4B\u0F9B] > Th;
[\u0F4C\u0F9C] > D;
[\u0F4E\u0F9E] > N;
[\u0F4F\u0F9F] > t;
[\u0F50\u0FA0] > th;
[\u0F51\u0FA1] > d;
[\u0F53\u0FA3] > n;
[\u0F54\u0FA4] > p;
[\u0F55\u0FA5] > ph;
[\u0F56\u0FA6] > b;
[\u0F58\u0FA8] > m;
[\u0F59\u0FA9] > ts;
[\u0F5A\u0FAA] > tsh;
[\u0F5B\u0FAB] > dz;
[\u0F5D\u0FAD\u0FBA] > w;
[\u0F5E\u0FAE] > zh;
[\u0F5F\u0FAF] > z;
\u0F60 > \';
[\u0F61\u0FB1\u0FBB] > y;
[\u0F62\u0FB2\u0FBC] > r;
[\u0F63\u0FB3] > l;
[\u0F64\u0FB4] > sh;
[\u0F65\u0FB5] > Sh;
[\u0F66\u0FB6] > s;
[\u0F67\u0FB7] > h;
[\u0F68\u0FB8] > ;

# punctuation
\u0F0B [$] > ;
\u0F0B > ' ';
\u0F0C > '*';
\u0F0D > '/';
\u0F0E > '//';
\u0F3A > '<';
\u0F3B > '>';
\u0F3C > '(';
\u0F3D > ')';

# numbers
\u0F20 > '0';
\u0F21 > '1';
\u0F22 > '2';
\u0F23 > '3';
\u0F24 > '4';
\u0F25 > '5';
\u0F26 > '6';
\u0F27 > '7';
\u0F28 > '8';
\u0F29 > '9';


