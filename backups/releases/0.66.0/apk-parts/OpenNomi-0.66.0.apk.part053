␀␀␀# Enter new rules here or select an existing rule above
# Author: Arne Mauser / Sovann Heng
# Email: amauser@google.com, sovheng@google.com
# Description: Khmer to Latin Transliteration
::[[:Khmer:][:block=KHMER:]\u200B[:P:]];
::NFKD(NFC);

# Khmer uses a complex script where a single character is composed of
# multiple unicode codepoints. The first codepoint is typically a
# consonant, followed by one or more consonants and vowels.  The
# pronunciation of vowels is ambiguous and in most cases depends on
# the preceding consonants and vowels.
#
# The consonants can be divided in two groups called "a-series" and
# "o-series". The vowel pronunciation is different when following
# a-series consonants and o-series consonants. There are also
# exceptions that explicitly or implicitly change vowel pronunciation.
#
# There is also agreement of vowel pronouncement across syllables
# within words (vowel harmony). The second vowel pronounciation has to
# agree with the previous vowel. E.g. if the previous vowel was from
# the a-series, the current vowel has to be from the a-series
#
# Vowel harmony is currently not handled in this ruleset.


# Coeng is a non-printing symbol that indicates that the following
# symbol is a subscript.
$coeng = [\u17D2];

# Muusikatoan character forces a-series on the following vowel
$muusikatoan = \u17C9;
# Treisap character forces o-series on the following vowel
$treisap = \u17CA;

$vowels = [\u17A3-\u17C5aeiou];
$consonants = [\u1780-\u17A2];
$nonconsonants = [^\u1780-\u17A2];
# List of o-series consonants including treisap
$oseries = [\u1782-\u1784\u1787-\u1789\u178C-\u178D\u1791-\u1793\u1796-\u179C\u17CA];
# List of a-series consonants including muusikatoan
$aseries = [\u1780\u1781\u1785\u1786\u178A\u178B\u178E\u178F\u1790\u1794\u1795\u179D\u179F-\u17A2\u17C9];

# First, dealing with word boundary
::Any-BreakInternal;
# Many web page also use zwsp to mark word boundary. Turn zwsp into space
\u200B } [[:Khmer:][:block=KHMER:][:P:]] > ' '; # zwsp -> space

# Convert discouraged characters to more common variants
\u17A3 > | \u17A2;

# some hardcoded exceptions where Sanskrit/Pali reading applies instead of plain Khmer
អធិរាជ > akthireach;
# Exceptions for harmony of U+17B6
ការងារ > karngear;

# Vowel insertion after consonant sequences
($aseries $coeng $consonants) } $consonants > | $1 a;
($oseries $coeng $consonants) } $consonants > | $1 o;

# Special treatment of U+179A (RO) in a consonant cluster at the end of words
# consonants removed at the end of words
$consonants { ($coeng $consonants) } [$] > ;

# First pass : vowel harmonization if the first sylable has an aseries
# consonant before U+17B6, the second appearance of this vowel is aseries, 
# too. Same with oseries.
# ($aseries $coeng* $consonants* $vowels*  $consonants*) ($oseries $coeng* $consonants*) (ា  $consonants*) > XXX; # $1 $2 $muusikatoan $3;
# ($oseries $coeng* $consonants* $vowels*  $consonants*) ($aseries $coeng* $consonants*) (ា  $consonants*) > YYY; # $1 $2 $treisap $3;
($aseries $coeng* $consonants* $vowels* $oseries $coeng* $consonants*) (ា) > $1 $muusikatoan $2;
($oseries $coeng* $consonants* $vowels* $aseries $coeng* $consonants*) (ា) > $1 $treisap $2;

::Null;

# Vowel pronunciation rules across subscripted consonants with following vowels
# ($aseries $consonants* $coeng $consonants*) } $vowels > | $1 $muusikatoan;
# ($oseries $consonants* $coeng $consonants*) } $vowels > | $1 $treisap;
($aseries $coeng $consonants*) } $vowels > | $1 $muusikatoan;
($oseries $coeng $consonants*) } $vowels > | $1 $treisap;

# Vowel combinations
(េះ) > eh;
($oseries) (េះ) > | $1 ih;
(ោះ) > aoh;
($oseries) (ោះ) > | $1 oh;
(\u17BB\u17C7) > oh ;
($oseries) (\u17BB\u17C7) > | $1 ouh ;

# Special cases involving U+17C6

# After U+1780 and U+1782
(គ ំ) > koum; # U+1780 U+17C6
អ ំ > am ; # U+1782 U+17C6

# Special case at the end of the word
(\u17B6\u17C6) [$] > am; # example ចាំ (cham)
($oseries) (\u17B6\u17C6) [$] > | $1 oam; # TODO verify ea example ទាំង(teang)

(\u17B6\u17C6) > a; # example ចាំ (cham)
($oseries) (\u17B6\u17C6) > | $1 ea; # example ទាំង(teang)

(\u17C6\u17B6) > am; # example ចាំ (cham)
($oseries) (\u17C6\u17B6) > | $1 oam; # example ទាំង(teang)

# Special case when consonant is following
# example ចាំ (cham)
(\u17B6\u17C6) } $consonants > a;
# example ទាំង(teang)
($oseries) (\u17B6\u17C6) } $consonants > | $1 oa;

# flipped case
# example ចាំ (cham)
(\u17C6\u17B6) } $consonants > a;
# example ទាំង(teang)
($oseries) (\u17C6\u17B6) } $consonants > | $1 oa;

# Special case for U+17CD (Toandakhiat) which indicates that the base character is not pronounced
[:Khmer:] \u17CD > ; # U+17CD Toandakhiat

# Dependent Vowels
($oseries) ា  > | $1 ea; # U+17B6
ា > a; # U+17B6
ិ > e; # U+17B7
($oseries) ិ > | $1 i; # U+17B7
ី > ei; # U+17B8
($oseries) ី > | $1 i; # U+17B8
ឹ > oe; # U+17B9
($oseries) ឹ > | $1 u; # U+17B9
ឺ > eu; # U+17BA
($oseries) ឺ > | $1 u; # U+17BA
( ុ ំ ) > om; # U+17BB U+17C6
($oseries) ុ ំ > | $1 oum; # U+17BB U+17C6
ុ > o; # U+17BB 
($oseries) ុ > | $1 ou; # U+17BB
ូ > au; # U+17BC
($oseries) ូ > | $1 ou; # U+17BC
ួ > uo; # U+17BD
ើ > ae; # U+17BE
($oseries) ើ > | $1 eu; # U+17BE
ឿ > ue; # U+17BF
ៀ > ie; # U+17C0
េ > e; # U+17C1
($oseries) េ > | $1 e; # U+17C1
ែ > e; # U+17C2
($oseries) ែ > | $1 e; # U+17C2
ៃ > ai; # U+17C3
($oseries) ៃ > | $1 ei; # U+17C3
ោ > ao; # U+17C4
($oseries) ោ > | $1 o; # U+17C4
ៅ > aw; # U+17C5
($oseries) ៅ > | $1 ow; # U+17C5
 ំ > am; # U+17C6
($oseries) ំ > | $1 om; # U+17C6
ះ > ah ; # U+17C7
($oseries) ះ > | $1 eah ; # U+17C7

# Consonants with consonants at the end of words
ក } $consonants [$] > ka; # U+1780
ខ } $consonants [$] > kha; # U+1781
គ } $consonants [$] > ko; # U+1782
ឃ } $consonants [$] > kho; # U+1783
ង } $consonants [$] > ngo; # U+1784
ច } $consonants [$] > cha; # U+1785
ឆ } $consonants [$] > chha; # U+1786
ជ } $consonants [$] > cho; # U+1787
ឈ } $consonants [$] > chho; # U+1788
ញ } $consonants [$] > nho; # U+1789
ដ } $consonants [$] > da; # U+178A
ឋ } $consonants [$] > tha; # U+178B
ឌ } $consonants [$] > do; # U+178C
ឍ } $consonants [$] > tho; # U+178D
ណ } $consonants [$] > na; # U+178E
ត } $consonants [$] > ta; # U+178F
ថ } $consonants [$] > tha; # U+1790
ទ } $consonants [$] > to; # U+1791
ធ } $consonants [$] > tho; # U+1792
ន } $consonants [$] > no; # U+1793
ប } $consonants [$] > ba; # U+1794
ផ } $consonants [$] > pha; # U+1795
ព } $consonants [$] > po; # U+1796
ភ } $consonants [$] > pho; # U+1797
ម } $consonants [$] > mo; # U+1798
យ } $consonants [$] > yo; # U+1799
រ } $consonants [$] > ro; # U+179A
ល } $consonants [$] > lo; # U+179B
វ } $consonants [$] > vo; # U+179C
ស } $consonants [$] > sa; # U+179F
ហ } $consonants [$] > ha; # U+17A0
ឡ } $consonants [$] > la; # U+17A1
# អ } $consonants [$] > a; # U+17A2

# Consonants with following two consonants
ក } $consonants $coeng* $consonants > ka; # U+1780
ខ } $consonants $coeng* $consonants > kha; # U+1781
គ } $consonants $coeng* $consonants > ko; # U+1782
ឃ } $consonants $coeng* $consonants > kho; # U+1783
ង } $consonants $coeng* $consonants > ngo; # U+1784
ច } $consonants $coeng* $consonants > cha; # U+1785
ឆ } $consonants $coeng* $consonants > chha; # U+1786
ជ } $consonants $coeng* $consonants > cho; # U+1787
ឈ } $consonants $coeng* $consonants > chho; # U+1788
ញ } $consonants $coeng* $consonants > nho; # U+1789
ដ } $consonants $coeng* $consonants > da; # U+178A
ឋ } $consonants $coeng* $consonants > tha; # U+178B
ឌ } $consonants $coeng* $consonants > do; # U+178C
ឍ } $consonants $coeng* $consonants > tho; # U+178D
ណ } $consonants $coeng* $consonants > na; # U+178E
ត } $consonants $coeng* $consonants > ta; # U+178F
ថ } $consonants $coeng* $consonants > tha; # U+1790
ទ } $consonants $coeng* $consonants > to; # U+1791
ធ } $consonants $coeng* $consonants > tho; # U+1792
ន } $consonants $coeng* $consonants > no; # U+1793
ប } $consonants $coeng* $consonants > ba; # U+1794
ផ } $consonants $coeng* $consonants > pha; # U+1795
ព } $consonants $coeng* $consonants > po; # U+1796
ភ } $consonants $coeng* $consonants > pho; # U+1797
ម } $consonants $coeng* $consonants > mo; # U+1798
យ } $consonants $coeng* $consonants > yo; # U+1799
រ } $consonants $coeng* $consonants > ro; # U+179A
ល } $consonants $coeng* $consonants > lo; # U+179B
វ } $consonants $coeng* $consonants > vo; # U+179C
#ស } $consonants $coeng* $consonants  > ś ṣ s; # U+179F
ស } $consonants $coeng* $consonants > sa; # U+179F
ហ } $consonants $coeng* $consonants > ha; # U+17A0
ឡ } $consonants $coeng* $consonants > la; # U+17A1
# អ } $consonants $coeng* $consonants > a; # U+17A2


# Special case for glottal stop that sometimes transliterates to 'a':
# អ ំ > a; # U+17A2 U+17C6
អ } $vowels > ; # U+17A2
អ } $consonants > a; # U+17A2


# Consonants w/ vowels
ក } $vowels > k; # U+1780
ខ } $vowels > kh; # U+1781
គ } $vowels > k; # U+1782
