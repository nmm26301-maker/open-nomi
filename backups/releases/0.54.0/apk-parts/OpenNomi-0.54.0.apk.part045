# before b, ch, d, dd, g, f, ff, th followed by the end of a word
# or a vowel

Ëˆ { É¨ } [bÏ‡dÃ°gvfÎ¸] $end â†’ É¨Ë;
Ëˆ { a } [bÏ‡dÃ°gvfÎ¸] $end â†’ É‘Ë;
Ëˆ { e } [bÏ‡dÃ°gvfÎ¸] $end â†’ eË;
